# ==============================================================================
# Pointer — Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
ENABLE_BACKGROUND_POLLER=false

# Option A: AWS Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0

# Option B: Google Cloud Vertex AI / AI Studio (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-flash

# Option C: Local Ollama / LM Studio (Offline & Private)
USE_LOCAL_MODEL=false
LOCAL_MODEL_PROVIDER=ollama      # "ollama" or "lm_studio"
LOCAL_MODEL_NAME=llama3.2
OLLAMA_BASE_URL=http://localhost:11434/v1
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# Optional: LangSmith Cloud Observability & Evals
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rolepointer-evals
