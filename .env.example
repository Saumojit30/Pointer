# ==============================================================================
# RolePointer — Configuration
# ==============================================================================
# Model Provider Selector: "auto" | "bedrock" | "gemini" | "ollama" | "lmstudio"
LLM_PROVIDER=auto

# ── 1. AWS BEDROCK (Official Boto3 Converse API & Strands SDK) ────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0

# ── 2. GOOGLE CLOUD (GCP) & GEMINI (Official google-genai SDK) ───────────────
# Option A: Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Option B: GCP Vertex AI (Requires GCP Project, Region & ADC/Service Account)
USE_VERTEX_AI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=

# ── 3. LOCAL OFFLINE MODELS (100% Free & Offline) ─────────────────────────────
USE_LOCAL_MODEL=false
LOCAL_MODEL_NAME=llama3.2
OLLAMA_BASE_URL=http://localhost:11434/v1
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# ── 4. LANGSMITH EVALUATION & TRACING (Optional Free Developer Tier) ──────────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rolepointer
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ── 5. APPLICATION SETTINGS ───────────────────────────────────────────────────
DATABASE_URL=sqlite:///rolepointer.db
APP_HOST=127.0.0.1
APP_PORT=8000
USE_MOCK_FEEDS=false
LOG_LEVEL=INFO


